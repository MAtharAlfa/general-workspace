# Deskripsi       : Program menerima input integer lalu memberi nilai permutasi dan kombinasi

def factorial(n):
    if n == 1 or n == 0:
        return 1

    return n * factorial(n - 1)


def kombinasi(n, r):
    return factorial(n) // (factorial(n - r) * factorial(r))

def permutasi(n, r):
    return factorial(n) // factorial(n - r)

def decimalFormat(nilai):
    return f"{nilai:.2f}"

def cetakKombinasi(n, r):
    print("Hasil:", decimalFormat(kombinasi(n, r)))

def cetakPermutasi(n, r):
    print("Hasil:", decimalFormat(permutasi(n, r)))

def main():
    cetakKombinasi(5,3)
    cetakPermutasi(5,2)

if __name__ == "__main__":
    main()